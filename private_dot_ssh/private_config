# Defaults for every host.
Host *
    # Hand the key to the running systemd ssh-agent on first use, so it is
    # unlocked once per session rather than read from disk on every connection.
    AddKeysToAgent yes
    # Offer only the keys named for a host, never every key in ~/.ssh. Without
    # this, ssh walks the whole set and can trip a server's MaxAuthTries.
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519
    # Reuse one connection for repeated sessions to the same host.
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m
    ServerAliveInterval 60
    ServerAliveCountMax 3
    HashKnownHosts no

Host github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
