#!/usr/bin/env python3
"""Back up Rex sessions on this Mac and its remote hosts, and reopen Claude after a restart.

Rex brings back sessions, tabs, splits and pane IDs after a server restart, but each pane
returns as a new shell. This records which Claude conversation ran in which pane, so they
can be reopened.

  rex-backup                     save a backup of every reachable host
  rex-backup list                show the saved backups
  rex-backup restore             preview what would be reopened
  rex-backup restore --apply     reopen them
  rex-backup watch               check once for restarted servers and reopen them (listen does this all the time)
  rex-backup listen              follow every server's events: a quick backup when Claude, btop or
                                 cswap starts or stops or a tab closes, and a reopen after a restart

A host whose backups fail twice in a row gets a Mac notification, and another when it recovers.
quarterdeck offices are never reopened: their bells restart them.

Restore uses the newest backup from before the current server started. A conversation is
reopened only if it isn't already running and its pane is sitting at an idle shell. It then
waits for input: unfinished work doesn't continue by itself.

Backups hold terminal scrollback, which can include secrets: they're in a private folder
(mode 0700) and must not go anywhere that syncs.
"""
import argparse, contextlib, datetime, fcntl, gzip, json, os, re, shlex, shutil, subprocess, sys, tempfile, threading, time

# Rex host label -> SSH alias for reading Claude's session records. None is this Mac.
HOSTS = {"local": None, "baba": "baba-herdr", "bifrost": "bifrost-herdr", "jbrown-dev": "jbrown-dev-herdr", "runcove-pmo": "runcove-pmo-herdr"}
ROOT = os.path.expanduser("~/.local/state/rex-backup")
# The listener adds small backups between the scheduled ones, so this is a few days' worth.
KEEP = 300
REX = shutil.which("rex") or os.path.expanduser("~/.local/bin/rex")
SSH = ["ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10"]
SHELLS = ("zsh", "bash", "sh", "fish")
# Programs restore may start again, by these fixed names. Anything else could repeat something
# destructive, so it's only listed for you to restart by hand.
PROGRAMS = ("btop", "cswap", "rexboard")
WATCH_STATE = os.path.join(ROOT, ".server-instances.json")
WATCH_MAX_AGE_HOURS = 24
FAILURES = os.path.join(ROOT, ".failures.json")
ALERT_AFTER = 2
RESTORE_TRIES_STATE = os.path.join(ROOT, ".restore-tries.json")
RESTORE_TRIES = 5
# The listener backs a host up this long after the first change it sees, and no more often than MIN_GAP.
DEBOUNCE, MIN_GAP = 30, 120
# Claude options worth carrying over, with how many values each takes. Anything else, such as a
# prompt, must not be replayed. Permission options come back only with restore --keep-permissions.
KEEP_FLAGS = {"--chrome": 0, "--model": 1}
PERMISSION_FLAGS = {"--dangerously-skip-permissions": 0, "--permission-mode": 1}
SAFE_VALUE = re.compile(r"[A-Za-z0-9._:\[\]-]+")
SAFE_ID = re.compile(r"[A-Za-z0-9_:-]+")
CONTROL = re.compile(r"[\x00-\x1f\x7f-\x9f]")

# Runs on the host: live Claude sessions by process, and the command line of each process asked for.
PROBE = r"""
import glob, json, os, stat, subprocess, sys
args = {}
for line in subprocess.run(["ps", "axww", "-o", "pid=,args="], capture_output=True, text=True, errors="replace").stdout.splitlines():
    p = line.split(None, 1)
    if len(p) == 2:
        args[p[0]] = p[1]
claude = {}
# SSH logs in as root on some hosts while Rex runs as another account (runcove-pmo), so look in
# every home. Only the panes' own PIDs are looked up, so other people's Claude sessions don't matter.
mine = os.path.expanduser("~/.claude/sessions/*.json")
for f in sorted(set(glob.glob(mine) + glob.glob("/home/*/.claude/sessions/*.json"))):
    # As root this reads other accounts' files, so trust one only if it's a small regular file
    # (never a link, FIFO or device) owned by the account that runs the process it names.
    try:
        fd = os.open(f, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_size > 65536:
                continue
            d = json.loads(os.read(fd, 65536))
        finally:
            os.close(fd)
        pid = int(d["pid"])
        os.kill(pid, 0)
        if st.st_uid != (os.stat(f"/proc/{pid}").st_uid if os.path.isdir("/proc/1") else st.st_uid):
            continue
    except (OSError, ValueError, KeyError, TypeError):
        continue
    if d.get("sessionId"):
        claude[str(d["pid"])] = {"conversation": d["sessionId"], "cwd": d.get("cwd"), "args": args.get(str(d["pid"]), "")}
cswap = any(w == "cswap" or w.endswith("/cswap") for a in args.values() for w in a.split()[:2])
print(json.dumps({"claude": claude, "args": {p: args.get(p, "") for p in sys.argv[1:]}, "cswap": cswap}))
"""


# Runs inside `rex do`: one line per change worth a backup. Ordinary shell commands are left out,
# so `ls` doesn't cost an SSH login. Claude's process is named after its version, such as 2.1.317.
LISTEN_LUA = r"""
local function interesting(name)
  if not name then return false end
  return name == "claude" or name == "btop" or name == "cswap"
    or name:match("^%d+%.%d+%.%d+$") ~= nil or name:match("^python") ~= nil
end
local function emit(kind) print(rex.json.encode({ kind = kind })) end
local last = {}
rex.on("block_event", function(_, ev)
  if ev.name ~= "process_changed" then return end
  local name = ev.foreground and ev.foreground.name
  local before = last[ev.block_id]
  last[ev.block_id] = name
  if name ~= before and (interesting(name) or interesting(before)) then emit("program") end
end)
for _, kind in ipairs({ "session_created", "session_destroyed", "window_created", "window_closed", "block_closed" }) do
  rex.on(kind, function() emit(kind) end)
end
local _, err = rex.call("session.attach_all", { event_scope = "session" })
if err then error(err, 0) end
emit("ready")
"""


class Partial(Exception):
    """The panes were saved, but not which Claude conversation each one holds."""


@contextlib.contextmanager
def locked(name):
    with open(os.path.join(ROOT, name), "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def now():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def run(*a, timeout=60, input=None):
    return subprocess.run(a, capture_output=True, text=True, errors="replace", timeout=timeout, input=input,
                          stdin=None if input is not None else subprocess.DEVNULL)


def rex(host, *a, timeout=60):
    return run(REX, *([] if host == "local" else ["-S", host]), *a, timeout=timeout)


def rex_json(host, *a):
    p = rex(host, *a)
    if p.returncode:
        raise RuntimeError((p.stderr or p.stdout).strip()[:200])
    return json.loads(p.stdout)


def probe(host, pids=()):
    pids = [str(p) for p in pids]
    alias = HOSTS[host]
    if alias:
        p = run(*SSH, alias, "python3 - " + " ".join(pids), input=PROBE, timeout=180)
    else:
        # Just after a login the Mac can take over a minute to start Python.
        p = run("python3", "-", *pids, input=PROBE, timeout=180)
    if p.returncode:
        raise RuntimeError((p.stderr or p.stdout).strip()[-200:])
    return json.loads(p.stdout)


def foreground(host, session_id, block):
    return rex_json(host, "block", "call", "process", "-s", session_id, "-b", block).get("foreground") or {}


def is_shell(fg):
    return (fg.get("argv0") or fg.get("name") or "").lstrip("-").rsplit("/", 1)[-1] in SHELLS


def at_prompt(host, session_id, block):
    """The pane's login shell is in front and its line editor is reading input."""
    process = rex_json(host, "block", "call", "process", "-s", session_id, "-b", block)
    fg = process.get("foreground") or {}
    if process.get("last_exit") is not None or not (fg.get("argv0") or "").startswith("-") or len(process.get("ancestors") or []) > 1:
        return False
    return rex_json(host, "block", "call", "input_mode", "-s", session_id, "-b", block).get("canonical") is False


def cswap_mode(text):
    found = re.findall(r"\b(LIVE|DRY-RUN)\b", text)
    return found[-1] if found else None


def program_of(command):
    # The program itself, or the script an interpreter runs: not a word passed to something else.
    words = [w.rsplit("/", 1)[-1] for w in (command or "").split()[:2]]
    if words and words[0] in PROGRAMS:
        return words[0]
    if len(words) == 2 and words[0].lower().startswith("python") and words[1] in PROGRAMS:
        return words[1]
    return None


def is_office(command):
    return bool(command) and "/quarterdeck/" in command


def restart_program(host, x, name, apply_changes):
    """Returns the number of problems. A program only ever starts in a pane at an idle shell."""
    where, session_id, block = f"{x['session']} / {x['tab']}", x["session_id"], x["block"]
    want = " and set it LIVE" if name == "cswap" and x.get("live") else ""
    if name == "cswap" and probe(host)["cswap"]:
        print(f"  cswap is already running on {host}, so it won't start a second: {where}")
        return 0
    exists = rex(host, "block", "ls", "-s", session_id, "-q", "--short=false")
    if exists.returncode or block not in exists.stdout.split():
        print(f"  pane gone, restart {name} by hand: {where}")
        return 1
    fg = foreground(host, session_id, block)
    if not is_shell(fg):
        print(f"  pane is running {fg.get('name') or 'nothing yet'}, left alone: {where}")
        return 0 if fg.get("name") == name else 1
    if not apply_changes:
        print(f"  would restart {name}{want}: {where}")
        return 0
    ready_by = time.time() + 30
    while not at_prompt(host, session_id, block) and time.time() < ready_by:
        time.sleep(1)
    if not at_prompt(host, session_id, block):
        print(f"  shell not ready after 30 seconds, restart {name} by hand: {where}")
        return 1
    typed = rex(host, "block", "call", "write", json.dumps({"data": f"\x05\x15 {name}\r"}), "-s", session_id, "-b", block)
    if typed.returncode:
        print(f"  FAILED to start {name}: {where}: {typed.stderr.strip()[:200]}")
        return 1
    time.sleep(5)
    if is_shell(foreground(host, session_id, block)):
        print(f"  {name} didn't stay running: {where}")
        return 1
    print(f"  restarted {name}: {where}")
    if not want:
        return 0
    # cswap starts in dry-run. Its Auto-switch view is third in the menu, and l then Enter goes live.
    for key in ("down", "down", "enter"):
        rex(host, "send-key", "-s", session_id, "-b", block, key)
        time.sleep(0.6)
    time.sleep(2)
    screen = lambda: cswap_mode(rex(host, "capture", "-s", session_id, "-b", block, "--trim").stdout)
    if screen() != "DRY-RUN":
        print(f"  cswap isn't in its dry-run view, so set it LIVE by hand: {where}")
        return 1
    rex(host, "send-key", "-s", session_id, "-b", block, "l")
    time.sleep(1)
    rex(host, "send-key", "-s", session_id, "-b", block, "enter")
    for _ in range(15):
        time.sleep(1)
        if screen() == "LIVE":
            print(f"  cswap is LIVE: {where}")
            return 0
    print(f"  cswap didn't go LIVE, so set it by hand: {where}")
    return 1


def blocks_of(view):
    for w in view.get("windows", []):
        for layer in w.get("layers", []):
            for b in layer.get("blocks", []):
                # IDs come from the server, which may be remote, and name files on this Mac.
                if "terminal" in b.get("flavor", "") and SAFE_ID.fullmatch(str(b.get("block_id"))):
                    yield w, b


def backup_host(host, folder, scrollback=True):
    status = rex_json(host, "api", "call", "server.status")
    sessions, panes, screens = [], [], {}
    os.makedirs(os.path.join(folder, "scrollback"))
    for s in rex_json(host, "ls", "--json")["sessions"]:
        if not SAFE_ID.fullmatch(str(s.get("session_id"))):
            continue
        # A session or pane can close while this runs: skip it rather than lose the host's whole backup.
        try:
            view = rex_json(host, "api", "call", "-s", s["session_id"], "session.view")
        except RuntimeError:
            continue
        sessions.append(view)
        for w, b in blocks_of(view):
            block = b["block_id"]
            try:
                fg = foreground(host, s["session_id"], block)
                states = rex_json(host, "block", "call", "program_status", "-s", s["session_id"], "-b", block).get("records") or []
            except RuntimeError:
                continue
            panes.append({"session_id": s["session_id"], "session": s.get("label"), "tab": w.get("label"), "block": block,
                          "pid": fg.get("pid"), "program": fg.get("name"), "shell": is_shell(fg), "cwd": fg.get("cwd"),
                          "state": states[0].get("state") if states else None})
            # A quick backup reads only screens that may show cswap's mode, and keeps no scrollback.
            if not scrollback and is_shell(fg):
                continue
            p = rex(host, "capture", "-s", s["session_id"], "-b", block, "--trim", "--unwrap", timeout=120)
            if p.returncode == 0:
                screens[block] = cswap_mode(p.stdout)
                if scrollback:
                    with gzip.open(os.path.join(folder, "scrollback", block.replace(":", "_") + ".txt.gz"), "wt") as f:
                        f.write(p.stdout)
    # No panes, no SSH login: scheduled runs shouldn't log in through Warpgate for nothing.
    live, probe_error = {"claude": {}, "args": {}}, None
    if panes:
        try:
            live = probe(host, [x["pid"] for x in panes if x["pid"] and not x["shell"]])
        except Exception as e:
            probe_error = str(e)
    agents = 0
    for x in panes:
        pid = str(x.pop("pid"))
        x["claude"] = live["claude"].get(pid)
        agents += bool(x["claude"])
        if not x["shell"] and not x["claude"] and not probe_error:
            x["command"] = live["args"].get(pid, "")
            x["live"] = screens.get(x["block"]) == "LIVE"
    manifest = {"host": host, "taken_at": now(), "server_started": status["started_at"],
                "server_instance": status["instance_id"], "scrollback": scrollback, "incomplete": probe_error,
                "sessions": sessions, "panes": panes}
    with open(os.path.join(folder, "manifest.json"), "w") as f:
        json.dump(manifest, f, indent=1)
    # Restore skips a backup with no conversations in it, so this one can't hide an older, complete one.
    if probe_error:
        raise Partial(f"{len(panes)} panes saved, but SSH failed, so not their conversations: {probe_error}")
    return len(sessions), len(panes), agents


def stamps():
    if not os.path.isdir(ROOT):
        return []
    return sorted(d for d in os.listdir(ROOT) if re.fullmatch(r"\d{8}-\d{6}", d))


def load(path):
    with open(path) as f:
        m = json.load(f)
    m.setdefault("panes", [])  # backups from the first draft of this script had none
    return m


def prune():
    """Keep the newest backups, and the last one with Claude in it from each server run."""
    protected = {}
    for s in stamps():
        for host in HOSTS:
            path = os.path.join(ROOT, s, host, "manifest.json")
            if os.path.exists(path):
                m = load(path)
                if any(x["claude"] for x in m["panes"]):
                    protected[host, m["server_instance"]] = s
    for old in stamps()[:-KEEP]:
        if old not in protected.values():
            shutil.rmtree(os.path.join(ROOT, old))


def record(host, error):
    """Notifies once when a host's backups keep failing, and once when they work again."""
    with locked(".failures.lock"):
        state = load_json(FAILURES)
        entry = state.get(host)
        if error is None:
            if entry and entry.get("alerted"):
                notify(f"{host} is being backed up again")
            state.pop(host, None)
        else:
            entry = entry or {"since": now(), "count": 0}
            entry["count"] += 1
            if entry["count"] >= ALERT_AFTER and not entry.get("alerted"):
                entry["alerted"] = True
                notify(f"{host} hasn't been backed up since {entry['since'][11:16]}: {CONTROL.sub(' ', error)[:120]}")
            state[host] = entry
        with open(FAILURES, "w") as f:
            json.dump(state, f)


def save_backup(hosts, scrollback=True):
    tmp = tempfile.mkdtemp(prefix=".", dir=ROOT)
    failed = 0
    for host in hosts:
        try:
            n, panes, agents = backup_host(host, os.path.join(tmp, host), scrollback)
            print(f"{host}: {n} sessions, {panes} panes, {agents} Claude conversations")
            record(host, None)
        except Partial as e:
            failed += 1
            print(f"{host}: backed up in part: {e}", file=sys.stderr)
            record(host, str(e))
        except Exception as e:
            failed += 1
            shutil.rmtree(os.path.join(tmp, host), ignore_errors=True)
            print(f"{host}: NOT backed up: {e}", file=sys.stderr)
            record(host, str(e))
    if not os.listdir(tmp):
        os.rmdir(tmp)
        return failed
    # The scheduled backup and the listener can finish in the same second.
    for _ in range(5):
        stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
        try:
            os.rename(tmp, os.path.join(ROOT, stamp))
            break
        except OSError:
            time.sleep(1)
    else:
        raise RuntimeError(f"couldn't name the backup in {tmp}")
    prune()
    print("saved", os.path.join(ROOT, stamp), flush=True)
    return failed


def cmd_backup(args):
    return 1 if save_backup(HOSTS) else 0


def cmd_list(args):
    for s in stamps():
        row = []
        for host in HOSTS:
            path = os.path.join(ROOT, s, host, "manifest.json")
            row.append(f"{host}:{sum(bool(x['claude']) for x in load(path)['panes'])}" if os.path.exists(path) else f"{host}:-")
        print(s, " ".join(row))
    return 0


def choose(host, instance, stamp):
    """Newest backup with Claude in it from before this server started, or the one asked for."""
    for s in ([stamp] if stamp else reversed(stamps())):
        path = os.path.join(ROOT, s, host, "manifest.json")
        if os.path.exists(path):
            m = load(path)
            if stamp or (m["server_instance"] != instance and any(x["claude"] for x in m["panes"])):
                return s, m
    return None, None


def resume_flags(args, keep_permissions):
    """Options from a flattened command line. Stops at anything not understood: it may be a prompt."""
    try:
        words = shlex.split(args)
    except ValueError:
        return []
    known = {**KEEP_FLAGS, **PERMISSION_FLAGS}
    flags, i = [], 1
    while i < len(words):
        w = words[i]
        if w in ("--resume", "-r"):
            i += 2
        elif w in known:
            values = words[i + 1:i + 1 + known[w]]
            if len(values) != known[w] or not all(SAFE_VALUE.fullmatch(v) for v in values):
                break
            # A stricter mode is always kept: dropping it could reopen the conversation in a looser one.
            if w in KEEP_FLAGS or keep_permissions or (w == "--permission-mode" and values[0] in ("auto", "default", "plan", "acceptEdits")):
                flags += [w, *values]
            i += 1 + known[w]
        else:
            break
    return flags


def resume_command(c, fallback_cwd, keep_permissions=False):
    parts = ["claude", "--resume", c["conversation"], *resume_flags(c["args"], keep_permissions)]
    cwd = c.get("cwd") or fallback_cwd
    return (f"cd {shlex.quote(cwd)} && " if cwd else "") + " ".join(shlex.quote(p) for p in parts)


def restore_host(host, args):
    instance = rex_json(host, "api", "call", "server.status")["instance_id"]
    stamp, m = choose(host, instance, args.stamp)
    if not m:
        print(f"{host}: no backup from before this server started, so nothing to reopen")
        return 0
    print(f"{host}: using the backup from {m['taken_at']} ({stamp})")
    running = {c["conversation"] for c in probe(host)["claude"].values()}
    problems, sent, programs = 0, [], []
    for x in m["panes"]:
        if args.session and x["session"] != args.session:
            continue
        where = f"{x['session']} / {x['tab']}"
        name = program_of(x.get("command"))
        # An office's bell restarts its session: reopening it here as well would run it twice.
        if is_office(x.get("command")) or (x["claude"] and is_office(x["claude"].get("args"))):
            print(f"  quarterdeck office, left to its bell: {where}")
            continue
        if name:
            programs.append((x, name))
        elif x.get("command"):
            print(f"  was running, restart by hand: {where}: {x['command'][:100]}")
        if not x["claude"]:
            continue
        c, session_id, block = x["claude"], x["session_id"], x["block"]
        command = resume_command(c, x.get("cwd"), args.keep_permissions)
        if not re.fullmatch(r"[A-Za-z0-9_.:-]+", c["conversation"]):
            problems += 1
            print(f"  unexpected conversation ID, left alone: {where}")
            continue
        # Quoting doesn't stop a typed Return from running the line, so nothing with control characters is typed.
        if CONTROL.search(command) or not SAFE_ID.fullmatch(str(session_id)) or not SAFE_ID.fullmatch(str(block)):
            problems += 1
            print(f"  unsafe characters in the saved details, left alone: {where}")
            continue
        if c["conversation"] in running:
            print(f"  already running: {where}")
            continue
        exists = rex(host, "block", "ls", "-s", session_id, "-q", "--short=false")
        if exists.returncode or block not in exists.stdout.split():
            problems += 1
            print(f"  pane gone, run by hand: {where}\n    {command}")
            continue
        fg = foreground(host, session_id, block)
        if not is_shell(fg):
            problems += 1
            print(f"  pane is running {fg.get('name') or 'nothing yet'}, left alone: {where}\n    {command}")
            continue
        note = " (it was mid-task, so tell it to carry on)" if x.get("state") not in (None, "idle") else ""
        if not args.apply:
            print(f"  would reopen: {where}{note}\n    {command}")
            continue
        ready_by = time.time() + 30
        while not at_prompt(host, session_id, block) and time.time() < ready_by:
            time.sleep(1)
        if not at_prompt(host, session_id, block):
            problems += 1
            print(f"  shell not ready after 30 seconds, left alone: {where}\n    {command}")
            continue
        # Clears the line first, and the leading space keeps it out of a history that skips such lines.
        typed = rex(host, "block", "call", "write", json.dumps({"data": f"\x05\x15 {command}\r"}), "-s", session_id, "-b", block)
        if typed.returncode:
            problems += 1
            print(f"  FAILED to send: {where}: {typed.stderr.strip()[:200]}")
            continue
        running.add(c["conversation"])
        print(f"  reopening: {where}{note}")
        sent.append((c["conversation"], where))
    end = time.time() + 90
    while sent and time.time() < end:
        time.sleep(3)
        now = {c["conversation"] for c in probe(host)["claude"].values()}
        for item in [i for i in sent if i[0] in now]:
            print(f"  running again: {item[1]}")
            sent.remove(item)
    for _, where in sent:
        problems += 1
        print(f"  NOT confirmed running after 90 seconds: {where}")
    for x, name in programs:
        problems += restart_program(host, x, name, args.apply)
    return problems


def cmd_restore(args):
    problems = 0
    for host in ([args.host] if args.host else HOSTS):
        try:
            problems += restore_host(host, args)
        except Exception as e:
            problems += 1
            print(f"{host}: couldn't check: {e}", file=sys.stderr)
    if not args.apply:
        print("Preview only. Add --apply to reopen them.")
    return 1 if problems else 0


def notify(text):
    script = "on run argv\ndisplay notification (item 1 of argv) with title \"Rex\"\nend run"
    # A notification is never worth losing a backup or a restore over: on a Mac too loaded to show
    # one in time, log it instead.
    try:
        run("osascript", "-e", script, text, timeout=20)
    except Exception as e:
        print(f"{now()} couldn't notify ({e.__class__.__name__}): {text}", flush=True)


def target(host):
    return ["--autostart=false", *([] if host == "local" else ["-S", host])]


def check_restart(host):
    """Reopen a host's conversations once, when its server instance changes. The first sight of a host
    changes nothing. The watcher and the listener both call this, so it holds a lock: only one reopens."""
    with locked(".restore.lock"):
        try:
            p = run(REX, *target(host), "api", "call", "server.status", timeout=20)
        except subprocess.TimeoutExpired:
            return  # a server that is still starting: the next run will see it
        if p.returncode:
            return
        instance = json.loads(p.stdout)["instance_id"]
        seen = load_json(WATCH_STATE)
        previous = seen.get(host)
        if previous == instance:
            return
        # Saved first, so a failure part-way can't reopen things a second time on the next run.
        seen[host] = instance
        with open(WATCH_STATE, "w") as f:
            json.dump(seen, f)
        if previous is None:
            return
        stamp, m = choose(host, instance, None)
        if not m:
            return
        age = datetime.datetime.now().astimezone() - datetime.datetime.fromisoformat(m["taken_at"])
        print(f"{now()} {host}: server restarted", flush=True)
        if age > datetime.timedelta(hours=WATCH_MAX_AGE_HOURS):
            print(f"{host}: backup is {age} old, so not reopening by itself", flush=True)
            notify(f"{host} restarted. Its backup is old: run rex-backup restore --host {host}")
            return
        try:
            problems = restore_host(host, argparse.Namespace(apply=True, session=None, stamp=stamp, keep_permissions=False))
        except Exception as e:
            # Restore skips conversations already running and panes not at a shell, so trying again is
            # safe: the next run of the watcher or listener does, up to RESTORE_TRIES times.
            tries = load_json(RESTORE_TRIES_STATE)
            n = tries.get(host, {}).get(instance, 0) + 1
            print(f"{host}: couldn't restore (try {n} of {RESTORE_TRIES}): {e}", flush=True)
            if n < RESTORE_TRIES:
                tries[host] = {instance: n}
                seen[host] = previous
                for path, data in ((RESTORE_TRIES_STATE, tries), (WATCH_STATE, seen)):
                    with open(path, "w") as f:
                        json.dump(data, f)
                return
            notify(f"{host} restarted, but its sessions couldn't be reopened: run rex-backup restore --apply --host {host}")
            return
        sys.stdout.flush()
        notify(f"{host} restarted and its sessions were reopened" + (f", with {problems} to check: see rex-backup.log" if problems else ""))


def cmd_watch(args):
    for host in HOSTS:
        try:
            check_restart(host)
        except Exception as e:
            print(f"{now()} watch: {host}: {e}", flush=True)
    return 0


def cmd_listen(args):
    """Follows each server's events. A change worth keeping schedules a quick backup of that host; a
    dropped stream is retried, and once it's back a changed server instance means a restart."""
    due, last = {}, {}
    wake = threading.Condition()

    def mark(host):
        with wake:
            due.setdefault(host, max(time.time() + DEBOUNCE, last.get(host, 0) + MIN_GAP))
            wake.notify()

    def follow(host):
        delay, state = 5, None
        while True:
            started, reason = time.time(), ""
            try:
                check_restart(host)
                p = subprocess.Popen([REX, *target(host), "do", "-", "--all"], stdin=subprocess.PIPE,
                                     stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
                p.stdin.write(LISTEN_LUA)
                p.stdin.close()
                for line in p.stdout:
                    try:
                        kind = json.loads(line).get("kind")
                    except (ValueError, AttributeError):
                        reason = line.strip()[:200] or reason
                        continue
                    if kind == "ready" and state != "up":
                        state = "up"
                        print(f"{now()} listen: {host}: following", flush=True)
                    # Reconnecting backs up too, to catch what changed while the stream was down.
                    mark(host)
                p.wait()
            except Exception as e:
                reason = str(e)[:200]
            if state != "down":
                state = "down"
                print(f"{now()} listen: {host}: lost, retrying: {reason}", flush=True)
            delay = 5 if time.time() - started > 300 else min(delay * 2, 60)
            time.sleep(delay)

    def recheck():
        # A stream that stays up never calls check_restart again, so a status read that timed out
        # (a Mac still loading after boot) or a restore left to retry would otherwise wait for a
        # reconnect that may never come. One status call per host a minute.
        while True:
            time.sleep(60)
            cmd_watch(None)

    for host in HOSTS:
        threading.Thread(target=follow, args=(host,), daemon=True).start()
    threading.Thread(target=recheck, daemon=True).start()
    while True:
        with wake:
            ready = [h for h, t in due.items() if t <= time.time()]
            if not ready:
                wake.wait(timeout=min([t - time.time() for t in due.values()] + [60]))
                continue
            for h in ready:
                del due[h]
                last[h] = time.time()
        print(f"{now()} listen: quick backup of {', '.join(ready)}", flush=True)
        try:
            save_backup(ready, scrollback=False)
        except Exception as e:
            print(f"{now()} listen: backup failed: {e}", flush=True)
        sys.stderr.flush()


def load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def main():
    os.umask(0o077)
    os.makedirs(ROOT, mode=0o700, exist_ok=True)
    os.chmod(ROOT, 0o700)
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command")
    sub.add_parser("backup", help="save a backup (the default)")
    sub.add_parser("list", help="show the saved backups and their Claude counts")
    sub.add_parser("watch", help="reopen by itself when a server has restarted")
    sub.add_parser("listen", help="follow every server: quick backups on changes, reopen after a restart")
    r = sub.add_parser("restore", help="reopen Claude conversations and allowed programs after a restart")
    r.add_argument("--apply", action="store_true", help="reopen them, rather than previewing")
    r.add_argument("--host", choices=list(HOSTS), help="only this host")
    r.add_argument("--session", help="only this Rex session, by name")
    r.add_argument("--stamp", help="use this backup, as shown by list")
    r.add_argument("--keep-permissions", action="store_true", help="also restore permission options the conversation was started with")
    args = ap.parse_args()
    sys.exit({"list": cmd_list, "restore": cmd_restore, "watch": cmd_watch, "listen": cmd_listen}.get(args.command, cmd_backup)(args))


if __name__ == "__main__":
    main()
