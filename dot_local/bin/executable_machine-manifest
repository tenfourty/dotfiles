#!/usr/bin/env bash
# Regenerate the machine manifest that chezmoi's run_onchange_ scripts consume.
#
# Captures what a fresh machine would need ON TOP of a stock Fedora KDE install:
# third-party repos, explicitly-wanted packages, flatpaks, and user-level tools.
# It deliberately does NOT capture the ~880 packages that come with the spin --
# those arrive with the installer image.
#
# Usage: machine-manifest [--write]      (--write updates the chezmoi source)
set -uo pipefail

OUT=$(chezmoi source-path 2>/dev/null)/.chezmoidata/packages.yaml
[[ ${1:-} == --write ]] || OUT=/dev/stdout
mkdir -p "$(dirname "$OUT")" 2>/dev/null

# Packages we asked for by name. Derived from dnf history rather than the full
# dependency closure, then filtered to things not present on a stock install.
# Exclusions, each for a specific reason:
#   kernel*        installed by the OS/updates, never by hand
#   *-libs, lib*   pulled in as dependencies of the things we DO name
#   <unknown>      attribution lost in the F43->F44 system-upgrade; these are
#                  mostly orphans, and anything genuinely wanted (tailscale,
#                  chrome) is re-added by its repo below
# The result is a DRAFT for a human to curate, not gospel: dnf does not record
# "the user asked for this" reliably across a system-upgrade chain.
mapfile -t EXPLICIT < <(
  sudo dnf repoquery --installed --qf '%{name}|%{from_repo}\n' 2>/dev/null \
    | awk -F'|' '
        $2 ~ /^(fedora|updates|@commandline|<unknown>|)$/ { next }
        $1 ~ /^kernel(-|$)/                               { next }
        $1 ~ /-libs$|^lib/                                { next }
        { print $1 }' | sort -u
)

{
  echo "# Generated by ~/.local/bin/machine-manifest -- do not hand-edit blindly."
  echo "# Regenerate:  machine-manifest --write && chezmoi apply"
  echo "#"
  echo "# What a fresh machine needs ON TOP of a stock Fedora KDE install."
  echo "# The base ~880 spin packages are NOT listed; they come with the installer."
  echo "packages:"

  echo "  copr:"
  for f in /etc/yum.repos.d/_copr*.repo; do
    [[ -e $f ]] || continue
    b=$(basename "$f" .repo); b=${b#_copr:copr.fedorainfracloud.org:}
    echo "    - ${b//:/\/}"
  done

  echo "  repos:"
  for f in /etc/yum.repos.d/*.repo; do
    b=$(basename "$f" .repo)
    case "$b" in fedora*|updates*|rpmfusion*|_copr*) continue;; esac
    url=$(grep -m1 -E '^(baseurl|metalink)=' "$f" 2>/dev/null | cut -d= -f2-)
    echo "    - name: $b"
    echo "      url: \"$url\""
  done

  # dnf5 config-manager writes these to /etc/dnf/repos.override.d/ rather than
  # editing the .repo files, so capturing the .repo files alone is NOT enough.
  # Without these, a fresh machine gets Chrome's repo disabled (it ships
  # enabled=0) and Terra at default priority instead of last-resort.
  echo "  repo_overrides:"
  if [ -d /etc/dnf/repos.override.d ]; then
    sudo awk '
      /^\[/ { gsub(/[][]/,""); repo=$0; next }
      /^[a-z_]+=/ && repo != "" { split($0,kv,"="); print "    - repo: " repo; print "      key: " kv[1]; print "      value: " kv[2] }
    ' /etc/dnf/repos.override.d/*.repo 2>/dev/null
  fi

  echo "  dnf:"
  printf '    - %s\n' "${EXPLICIT[@]}"

  echo "  flatpak:"
  flatpak list --app --columns=application 2>/dev/null | sed 's/^/    - /'

  echo "  cargo:"
  for b in ~/.cargo/bin/*; do
    [[ -x $b && -f $b ]] || continue
    n=$(basename "$b")
    [[ $n == cargo-binstall ]] && continue
    echo "    - $n"
  done

  echo "  uv:"
  uv tool list 2>/dev/null | awk '/^[a-z]/ {print "    - "$1}' | sort -u
} > "$OUT"

[[ $OUT == /dev/stdout ]] || echo "wrote $OUT ($(grep -c '^\s*-' "$OUT") entries)"
