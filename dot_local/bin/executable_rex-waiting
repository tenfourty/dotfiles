#!/usr/bin/env python3
"""Show the agent panes on this Mac and every Rex host, most in need of you first. Read-only."""
import concurrent.futures, datetime, json, os, re, shutil, subprocess

REX = shutil.which("rex") or os.path.expanduser("~/.local/bin/rex")
RANK = {"blocked": 0, "error": 1, "done": 2, "working": 3, "idle": 4}


def rex(host, *a):
    p = subprocess.run([REX, *([] if host == "this Mac" else ["-S", host]), *a], capture_output=True, text=True,
                       errors="replace", timeout=30, stdin=subprocess.DEVNULL)
    if p.returncode:
        raise RuntimeError((p.stderr or p.stdout).strip().splitlines()[0][:120])
    return json.loads(p.stdout)


def age(stamp):
    try:
        then = datetime.datetime.fromisoformat(re.sub(r"\.\d+", "", stamp).replace("Z", "+00:00"))
    except (AttributeError, ValueError):
        return "?"
    minutes = int((datetime.datetime.now(datetime.timezone.utc) - then).total_seconds() // 60)
    return f"{minutes}m" if minutes < 120 else f"{minutes // 60}h"


def scan(host):
    rows = []
    for s in rex(host, "ls", "--json")["sessions"]:
        view = rex(host, "api", "call", "-s", s["session_id"], "session.view")
        for w in view.get("windows", []):
            for layer in w.get("layers", []):
                for b in layer.get("blocks", []):
                    if "terminal" not in b.get("flavor", ""):
                        continue
                    records = rex(host, "block", "call", "program_status", "-s", s["session_id"], "-b", b["block_id"]).get("records") or []
                    if records:
                        r = min(records, key=lambda x: RANK.get(x.get("state"), 4))
                        rows.append((RANK.get(r.get("state"), 4), host, s.get("label") or "", w.get("label") or "",
                                     r.get("state") or "?", r.get("kind") or "", age(r.get("updated_at"))))
    return rows


def main():
    hosts = ["this Mac"] + [h["host"]["label"] for h in rex("this Mac", "hosts", "list", "--json")["hosts"]]
    rows, down = [], []
    with concurrent.futures.ThreadPoolExecutor(len(hosts)) as pool:
        for host, job in [(h, pool.submit(scan, h)) for h in hosts]:
            try:
                rows += job.result()
            except Exception as e:
                down.append(f"{host}: {e}")
    rows.sort(key=lambda r: (r[0], r[1], r[2], r[3]))
    if rows:
        widths = [max(len(str(r[i])) for r in rows + [(0, "HOST", "SESSION", "TAB", "STATE", "WAITING FOR", "SINCE")]) for i in range(1, 7)]
        for r in [(0, "HOST", "SESSION", "TAB", "STATE", "WAITING FOR", "SINCE")] + rows:
            print("  ".join(str(r[i + 1]).ljust(widths[i]) for i in range(6)).rstrip())
    else:
        print("No agent panes.")
    for d in down:
        print("unreachable", d)


if __name__ == "__main__":
    main()
