# Generated by `chezmoi init` on each machine. Committed so that a new machine
# gets the age configuration automatically -- otherwise you would clone the repo,
# hold the right key, and still not be able to decrypt anything.
#
# The recipient (public key) is safe to commit. The identity file it points at
# is NOT in this repo: restore it from the Dashlane secure note
# "chezmoi dotfiles - age identity" before running chezmoi init.

# Record where this machine's source lives, so plain `chezmoi` finds it when the
# clone is not at the default ~/.local/share/chezmoi (the Mac keeps it in ~/repos).
sourceDir = {{ .chezmoi.sourceDir | quote }}
encryption = "age"

[age]
identity = "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"
recipient = "age1ycqmpcmcygk0keenge3kfa6ua3y53plnkud8x0wnalnh4mzdlenqvwv30n"

[diff]
pager = "delta"
